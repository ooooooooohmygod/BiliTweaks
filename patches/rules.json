{
  "name": "bili-noads",
  "description": "哔哩哔哩 Android 客户端去广告补丁规则（开屏直进 + 去暂停页广告 + 去更新检测）",
  "target": {
    "package": "tv.danmaku.bili",
    "versionName": "9.15.0",
    "versionCode": 9150300,
    "arch": "arm64-v8a"
  },
  "ops": {
    "force_false": "把方法体替换为 const/4 v0, 0x0 + return v0（布尔方法恒 false）",
    "force_void": "把方法体替换为 return-void（void 方法整体禁用，副作用一并跳过）",
    "force_null": "把方法体替换为 const/4 v0, 0x0 + return-object v0（引用方法恒 null，副作用一并跳过）",
    "null_returns": "在该方法的每个 return-object vX 前插入 const/4 vX, 0x0（引用返回值恒 null，保留原有副作用）"
  },
  "patches": [
    {
      "id": "paused-page-enable",
      "dex": "classes4.dex",
      "desc": "暂停页总开关恒 false：暂停/双击时直接跳过暂停页广告流程",
      "class": "Lcom/bilibili/adcommon/config/DDConfig;",
      "method": "getPausePageEnable()Z",
      "op": "force_false",
      "expect_changes": 1
    },
    {
      "id": "paused-page-decode",
      "dex": "classes15.dex",
      "desc": "结束页广告数据解码入口恒 false：不再解码、不再调度显示",
      "class": "Lcom/bilibili/ship/theseus/united/page/pausedpage/PausedPageService;",
      "method": "R([BZ)Z",
      "op": "force_false",
      "expect_changes": 1
    },
    {
      "id": "paused-page-fallback",
      "dex": "classes15.dex",
      "desc": "结束页兜底显示入口恒 false",
      "class": "Lcom/bilibili/ship/theseus/united/page/pausedpage/PausedPageService;",
      "method": "e0([B)Z",
      "op": "force_false",
      "expect_changes": 1
    },
    {
      "id": "splash-tv-orders",
      "dex": "classes23.dex",
      "desc": "TV 侧开屏组件取订单恒 null：杀死冷启动/唤起/实时开屏订单（覆盖两个返回分支）",
      "class": "Ltv/danmaku/bili/MainActivitySplashComponentExtKt;",
      "method": "a(Ltv/danmaku/bili/MainActivityV2;)Ltv/danmaku/bili/splash/ad/model/SplashOrder;",
      "op": "null_returns",
      "expect_changes": 2
    },
    {
      "id": "splash-kntr-content",
      "dex": "classes23.dex",
      "desc": "kntr 侧开屏内容恒 null：无订单可展示 -> 触发 Dismiss -> 容器隐藏",
      "class": "Lkntr/srcs/app/splash/core/vm/BusinessSplashViewModel;",
      "method": "a(Lkntr/srcs/app/splash/model/SplashSource;)Lqj1/q;",
      "op": "null_returns",
      "expect_changes": 1
    },
    {
      "id": "splash-page-factory",
      "dex": "classes25.dex",
      "desc": "开屏页面工厂恒 null：所有 BaseSplash 页面（含 HotSplashActivity）不产生内容，入口即退",
      "class": "Ltv/danmaku/bili/splash/ad/core/SplashManager;",
      "method": "a(Ltv/danmaku/bili/splash/ad/model/SplashOrder;)Ltv/danmaku/bili/splash/ad/page/BaseSplash;",
      "op": "null_returns",
      "expect_changes": 1
    },
    {
      "id": "update-check-startup",
      "dex": "classes25.dex",
      "desc": "启动静默检查总入口禁用：冷启动不再探测新版本，也不会触发强制更新弹窗",
      "class": "Ltv/danmaku/bili/update/api/UpdateHelper;",
      "method": "checkUpdateInStartup(Landroid/app/Activity;Ltv/danmaku/bili/update/api/updater/IUpdater;)V",
      "op": "force_void",
      "expect_changes": 1
    },
    {
      "id": "update-check-manual",
      "dex": "classes25.dex",
      "desc": "手动检查 / 兼容性升级总入口禁用：设置里“检查更新”不再请求版本接口",
      "class": "Ltv/danmaku/bili/update/api/UpdateHelper;",
      "method": "checkUpdateAndShowDialog(Landroid/content/Context;Ltv/danmaku/bili/update/api/updater/IUpdater;)V",
      "op": "force_void",
      "expect_changes": 1
    },
    {
      "id": "update-cached-force",
      "dex": "classes25.dex",
      "desc": "本地缓存的强制更新信息读取恒 null：已下载更新包不再触发强制更新弹窗",
      "class": "Lqs1/g;",
      "method": "call()Ljava/lang/Object;",
      "op": "force_null",
      "expect_changes": 1
    },
    {
      "id": "update-install-prompt",
      "dex": "classes9.dex",
      "desc": "已下载更新包安装提示禁用：apk_store_info 残留不再弹“安装新版本”对话框",
      "class": "Ly30/l$a;",
      "method": "checkInstall(Landroid/content/Context;)V",
      "op": "force_void",
      "expect_changes": 1
    }
  ]
}
