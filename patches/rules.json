{
  "name": "bili-noads",
  "description": "哔哩哔哩 Android 客户端去广告补丁规则（开屏直进 + 去暂停页广告）",
  "target": {
    "package": "tv.danmaku.bili",
    "versionName": "9.15.0",
    "versionCode": 9150300,
    "arch": "arm64-v8a"
  },
  "ops": {
    "force_false": "把方法体替换为 const/4 v0, 0x0 + return v0（布尔方法恒 false）",
    "null_returns": "在该方法的每个 return-object vX 前插入 const/4 vX, 0x0（引用返回值恒 null，保留原有副作用）"
  },
  "patches": [
    {
      "id": "paused-page-enable",
      "dex": "classes4.dex",
      "desc": "暂停页总开关恒 false：暂停/双击时直接跳过暂停页广告流程",
      "class": "Lcom/bilibili/adcommon/config/DDConfig;",
      "method": "getPausePageEnable()Z",
      "op": "force_false",
      "expect_changes": 1
    },
    {
      "id": "paused-page-decode",
      "dex": "classes15.dex",
      "desc": "结束页广告数据解码入口恒 false：不再解码、不再调度显示",
      "class": "Lcom/bilibili/ship/theseus/united/page/pausedpage/PausedPageService;",
      "method": "R([BZ)Z",
      "op": "force_false",
      "expect_changes": 1
    },
    {
      "id": "paused-page-fallback",
      "dex": "classes15.dex",
      "desc": "结束页兜底显示入口恒 false",
      "class": "Lcom/bilibili/ship/theseus/united/page/pausedpage/PausedPageService;",
      "method": "e0([B)Z",
      "op": "force_false",
      "expect_changes": 1
    },
    {
      "id": "splash-tv-orders",
      "dex": "classes23.dex",
      "desc": "TV 侧开屏组件取订单恒 null：杀死冷启动/唤起/实时开屏订单（覆盖两个返回分支）",
      "class": "Ltv/danmaku/bili/MainActivitySplashComponentExtKt;",
      "method": "a(Ltv/danmaku/bili/MainActivityV2;)Ltv/danmaku/bili/splash/ad/model/SplashOrder;",
      "op": "null_returns",
      "expect_changes": 2
    },
    {
      "id": "splash-kntr-content",
      "dex": "classes23.dex",
      "desc": "kntr 侧开屏内容恒 null：无订单可展示 -> 触发 Dismiss -> 容器隐藏",
      "class": "Lkntr/srcs/app/splash/core/vm/BusinessSplashViewModel;",
      "method": "a(Lkntr/srcs/app/splash/model/SplashSource;)Lqj1/q;",
      "op": "null_returns",
      "expect_changes": 1
    },
    {
      "id": "splash-page-factory",
      "dex": "classes25.dex",
      "desc": "开屏页面工厂恒 null：所有 BaseSplash 页面（含 HotSplashActivity）不产生内容，入口即退",
      "class": "Ltv/danmaku/bili/splash/ad/core/SplashManager;",
      "method": "a(Ltv/danmaku/bili/splash/ad/model/SplashOrder;)Ltv/danmaku/bili/splash/ad/page/BaseSplash;",
      "op": "null_returns",
      "expect_changes": 1
    }
  ]
}
